---
import '../styles/global.css';

interface Props {
	locale: string;
	title: string;
	description: string;
	author: string;
	alternateUrls: { id: string; en: string };
}

const { locale, title, description, author, alternateUrls } = Astro.props;
const site = Astro.site;
const canonicalURL = site ? new URL(Astro.url.pathname, site) : undefined;
const ogImageURL = site ? new URL('/og.png', site) : undefined;

const idURL = site ? new URL(alternateUrls.id, site) : undefined;
const enURL = site ? new URL(alternateUrls.en, site) : undefined;

const ogLocale = locale === 'en' ? 'en_US' : 'id_ID';
const ogLocaleAlternate = locale === 'en' ? 'id_ID' : 'en_US';
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#F7F4EF" />
		{site && (
			<>
				<link rel="canonical" href={canonicalURL} />
				<meta property="og:url" content={canonicalURL} />
				<meta property="og:image" content={ogImageURL} />
			</>
		)}
		{idURL && <link rel="alternate" hreflang="id" href={idURL} />}
		{enURL && <link rel="alternate" hreflang="en" href={enURL} />}
		{idURL && <link rel="alternate" hreflang="x-default" href={idURL} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
