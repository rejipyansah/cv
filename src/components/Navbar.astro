---
const navItems = [
	{ label: 'About', href: '#about' },
	{ label: 'Experience', href: '#experience' },
	{ label: 'Projects', href: '#projects' },
	{ label: 'Skills', href: '#skills' },
	{ label: 'Contact', href: '#contact' },
];
---

<nav class="navbar" aria-label="Main navigation">
	<a href="/" class="logo">Reji</a>

	<input
		type="checkbox"
		id="nav-toggle"
		class="nav-toggle-input"
		aria-label="Toggle navigation menu"
	/>

	<label for="nav-toggle" class="nav-toggle" aria-hidden="true">
		<span class="bar"></span>
		<span class="bar"></span>
		<span class="bar"></span>
	</label>

	<div class="links">
		{navItems.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
	</div>
</nav>

<style>
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		width: 100%;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		background: rgba(10, 10, 10, 0.8);
	}

	.logo {
		color: var(--color-text);
		font-weight: 700;
		font-size: 1.1rem;
		z-index: 101;
	}

	.nav-toggle-input {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		z-index: 101;
		padding: 10px;
		min-width: 44px;
		min-height: 44px;
		align-items: center;
		justify-content: center;
	}

	.bar {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--color-text);
		border-radius: 2px;
		transition:
			transform var(--transition-fast),
			opacity var(--transition-fast);
	}

	.links {
		display: flex;
		gap: 1.5rem;
	}

	.links a {
		color: var(--color-muted);
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.links a:hover {
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.navbar {
			padding: 1rem 1.5rem;
		}

		.nav-toggle {
			display: flex;
		}

		.links {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100%;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 2rem;
			background: var(--color-bg);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity var(--transition-fast),
				visibility var(--transition-fast);
		}

		.links a {
			font-size: 1.25rem;
		}

		.nav-toggle-input:checked ~ .links {
			opacity: 1;
			visibility: visible;
		}

		.nav-toggle-input:checked ~ .nav-toggle .bar:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}

		.nav-toggle-input:checked ~ .nav-toggle .bar:nth-child(2) {
			opacity: 0;
		}

		.nav-toggle-input:checked ~ .nav-toggle .bar:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>
