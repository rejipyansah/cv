---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const name = 'Reji Pikriyansah';
const role = 'Fullstack Developer';
const location = 'Bandung, Jawa Barat';
const email = 'rejipyansah@gmail.com';

const experiences = [
	{
		project: 'Invoice Pro',
		role: 'Fullstack Developer',
		date: 'Aug 2026 — Present',
	},
	{
		project: 'Bank BJBS',
		role: 'Frontend Developer',
		date: 'Aug 2025 — Jul 2026',
	},
	{
		project: 'KMS BPK RI',
		role: 'Fullstack Developer',
		date: 'Jan 2025 — Feb 2026',
	},
	{
		project: 'Tap-MM',
		role: 'Fullstack Developer',
		date: 'Aug 2024 — Dec 2024',
	},
	{
		project: 'SISAPRA',
		role: 'Frontend Developer',
		date: 'Mar 2024 — Aug 2024',
	},
	{
		project: 'Loan Management System',
		role: 'Frontend Developer',
		date: 'Aug 2022 — Feb 2024',
	},
];

const skillCategories = [
	{
		label: 'Frontend',
		items: 'React.js, Next.js, TypeScript, JavaScript, Vite',
	},
	{
		label: 'Backend',
		items: 'Express.js, Golang, Laravel, ASP.NET Core',
	},
	{
		label: 'Database',
		items: 'PostgreSQL, SQL Server, MySQL, MongoDB',
	},
	{
		label: 'Tools & practices',
		items: 'Git, Docker',
	},
];

const socialLinks = [
	{ label: 'Email', href: `mailto:${email}` },
	{ label: 'GitHub', href: 'https://github.com/rejipyansah' },
];
---

<Layout
	title={`${name} — ${role}`}
	description={`${name} — ${role} with 4+ years of web development experience in enterprise and banking applications.`}
	author={name}
>
	<Navbar />

	<main>
		<!-- Hero -->
		<section class="hero">
			<div class="wrap">
				<div class="kicker">Portfolio</div>
				<h1>Reji<br />Pikriyansah</h1>
				<p class="role">Fullstack developer, from the frontend outward</p>
				<p class="intro">
					4+ years building web applications across banking, government,
					and enterprise systems. Started in frontend engineering and gradually
					expanded into backend services, databases, and production systems.
				</p>

				<div class="cta-row">
					<a class="btn-primary" href="#work">View work</a>
					<a class="link-text" href="#contact">Get in touch</a>
				</div>

				<div class="strip">
					<div class="item">
						<div class="num">4+</div>
						<div class="label">years of experience</div>
					</div>
					<div class="item">
						<div class="num">Frontend → Fullstack</div>
						<div class="label">career progression</div>
					</div>
					<div class="item">
						<div class="num">Banking · Gov · Enterprise</div>
						<div class="label">domains worked in</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience -->
		<section class="experience" id="experience">
			<div class="wrap">
				<div class="s-kicker">Experience</div>
				<div class="s-title">Where I've worked</div>

				<div class="employer-line">
					<span class="name">PT Tristar Surya Gemilang</span>
					<span class="date">Aug 2022 — Present</span>
				</div>
				<p class="employer-sub">
					Multiple project assignments across banking, government, and
					enterprise systems.
				</p>

				{experiences.map((exp, i) => (
					<div class="proj-line">
						<span class="proj-idx">{String(i + 1).padStart(2, '0')}</span>
						<div>
							<div class="proj-name">{exp.project}</div>
							<div class="proj-role">{exp.role}</div>
						</div>
						<div class="proj-date">{exp.date}</div>
					</div>
				))}
			</div>
		</section>

		<!-- Featured Project -->
		<section class="featured" id="work">
			<div class="featured-head">
				<div class="s-kicker">Featured project</div>
				<div class="s-title" style="margin-bottom: 0;">What I build for myself</div>
			</div>

			<div class="gallery-frame">
				<span>product preview — replace with Life OS screenshot</span>
			</div>

			<div class="fp-body">
				<div class="fp-top">
					<div>
						<div class="fp-title">Life OS</div>
						<div class="fp-sub">Personal Finance System</div>
					</div>
					<div class="fp-actions">
						<a class="btn-primary" href="#">View live</a>
						<a class="link-text" href="#">GitHub</a>
						<a class="link-text" href="#">Case study</a>
					</div>
				</div>

				<p class="fp-desc">
					Making everyday financial tracking require less friction.
				</p>

				<div class="fp-stack">
					<span class="stack-tag">React</span>
					<span class="stack-tag">TypeScript</span>
					<span class="stack-tag">ASP.NET Core</span>
					<span class="stack-tag">PostgreSQL</span>
				</div>
				<p class="fp-note">Add real links and screenshot before publishing.</p>

				<div class="fp-case">
					<div>
						<div class="label">Problem</div>
						<div class="body">— add problem description —</div>
					</div>
					<div>
						<div class="label">Approach</div>
						<div class="body">— add approach description —</div>
					</div>
					<div>
						<div class="label">Engineering focus</div>
						<div class="body">— add technical focus notes —</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="skills" id="skills">
			<div class="wrap">
				<div class="s-kicker">Skills</div>
				<div class="s-title">Toolset</div>

				{skillCategories.map((cat) => (
					<div class="skill-row">
						<div class="g-label">{cat.label}</div>
						<div class="g-items">{cat.items}</div>
					</div>
				))}
			</div>
		</section>

		<!-- Contact -->
		<section class="contact" id="contact">
			<div class="wrap">
				<div class="contact-panel">
					<div>
						<div class="contact-text">
							Open to fullstack roles across enterprise and financial systems.
						</div>
						<div class="contact-links">
							{socialLinks.map((link) => (
								<a href={link.href}>{link.label.toLowerCase()} — {link.href === `mailto:${email}` ? email : link.href}</a>
							))}
						</div>
					</div>
					<a class="btn-primary" href={`mailto:${email}`}>Send an email</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
