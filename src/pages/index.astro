---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const name = 'Reji Pikriyansah';
const role = 'Frontend-strong Fullstack Developer';
const email = 'rejipyansah@gmail.com';
const github = 'https://github.com/rejipyansah';
const linkedin = 'https://www.linkedin.com/in/reji-pikriyansah';

const experiences = [
	{
		project: 'Invoice Pro',
		role: 'Fullstack Developer (maintenance)',
		date: 'Agu 2026 – sekarang',
		tags: ['React', 'Express.js', 'PostgreSQL', 'Docker'],
		lead: 'Sistem pemrosesan invoice AP untuk enterprise.',
		bullets: [
			'Memperbaiki bug di environment development dan production (three-way matching, approval workflow, voucher, rekonsiliasi bank).',
			'Mengubah proses generate voucher dari manual menjadi otomatis.',
			'Mengubah tabel dari client-side ke server-side karena data sudah lebih dari 5.000 baris.',
			'Memperbaiki data tanggal yang bergeser ±7 jam setelah zona waktu worker diubah ke UTC+7.',
			'Menangani Docker dan deployment; sesekali menyentuh Airflow.',
		],
	},
	{
		project: 'Bank BJBS: Aplikasi Internal',
		role: 'Frontend Developer',
		date: 'Agu 2025 – Jul 2026',
		tags: ['Laravel (Blade)', 'React', 'Next.js'],
		bullets: [
			'SISUKA (surat-menyurat): memperbaiki bug penempatan tanda tangan, lalu menyelesaikan permintaan klien: tanda tangan drag & drop dengan resize, penggantian tanda tangan dengan QRIS, penggantian library PDF, dan kompresi hasil PDF dari ±15 MB menjadi ratusan KB.',
			'SIPADD dan SMART: mengerjakan sebagian besar frontend bersama tim.',
		],
	},
	{
		project: 'KMS BPK RI',
		role: 'Fullstack Developer',
		date: 'Jan 2025 – Feb 2026',
		tags: ['React (Vite)', 'Golang', 'SQL Server'],
		bullets: [
			'Mengerjakan sebagian besar frontend dan sebagian backend (logika bisnis, query, penyimpanan data) pada fitur knowledge management.',
			'Dikerjakan paralel dengan proyek BJBS.',
		],
	},
	{
		project: 'Tap-MM: Warehouse Management System',
		role: 'Fullstack Developer',
		date: 'Agu 2024 – Des 2024',
		tags: ['React', 'GraphQL', 'Golang', 'PostgreSQL'],
		bullets: [
			'Dipindahkan dari SISAPRA karena proyek membutuhkan developer yang bisa frontend dan backend.',
			'Bug fixing dan membantu rekan tim lintas modul.',
		],
	},
	{
		project: 'SISAPRA: Satpol PP DKI Jakarta',
		role: 'Frontend Developer',
		date: 'Mar 2024 – Agu 2024',
		tags: ['Next.js'],
		bullets: [
			'Membangun modul absensi (frontend), mengintegrasikannya dengan backend, serta melakukan functional testing dan bug fixing.',
		],
	},
	{
		project: 'Loan Management System: Bank BJB',
		role: 'Frontend Developer',
		date: 'Agu 2022 – Feb 2024',
		tags: ['Next.js', 'React Native', 'SQL Server'],
		bullets: [
			'KPR: mengerjakan sebagian besar modul frontend, bekerja bersama tim QA dan Security agar sesuai standar keandalan dan keamanan perbankan.',
			'Konsumer: di masa awal bergabung, mengerjakan sebagian kecil frontend web dan aplikasi mobile (React Native).',
		],
	},
];

const skillCategories = [
	{
		label: 'Sehari-hari',
		items: 'React, Next.js, TypeScript, JavaScript, Laravel (Blade)',
	},
	{
		label: 'Backend & data (berkembang)',
		items: 'Golang, ASP.NET Core, Node.js/Express, GraphQL · PostgreSQL, SQL Server (query, view, materialized view)',
	},
	{
		label: 'Mobile',
		items: 'React Native (proyek Konsumer)',
	},
	{
		label: 'Delivery',
		items: 'Git (workflow tim), Docker, deployment, functional/manual testing · Airflow (sesekali)',
	},
	{
		label: 'Pernah dipakai',
		items: 'CodeIgniter, MySQL, MongoDB',
	},
	{
		label: 'Sedang dipelajari',
		items: 'automated testing, CI/CD, DevOps',
	},
];
---

<Layout
	title={`${name} — ${role}`}
	description="Portfolio Reji Pikriyansah — Frontend-strong Fullstack Developer. 4+ tahun membangun aplikasi web untuk perbankan, pemerintahan, dan enterprise. Kuat di React/Next.js, terus berkembang ke backend (Golang, ASP.NET Core), database, dan deployment dengan Docker."
	author={name}
>
	<Navbar />

	<main>
		<!-- Hero -->
		<section class="hero">
			<div class="wrap">
				<div class="kicker">Portfolio</div>
				<h1>Reji<br />Pikriyansah</h1>
				<p class="role">Frontend-strong Fullstack Developer</p>
				<p class="intro">
					4+ tahun membangun aplikasi web untuk perbankan, pemerintahan, dan
					enterprise. Kuat di React/Next.js, terus berkembang ke backend
					(Golang, ASP.NET Core), database, dan deployment dengan Docker.
				</p>
				<p class="hero-meta">
					Bandung · WFO / hybrid / WFH · Bersedia ditempatkan di luar Bandung · Notice period 1 bulan (dapat dinegosiasikan)
				</p>

				<div class="cta-row">
					<a class="btn-primary" href="/Reji_Pikriyansah_CV.pdf" download>Unduh CV</a>
					<a class="btn-secondary" href={`mailto:${email}`}>Kirim email</a>
				</div>

				<div class="hero-social">
					<a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
					</a>
					<a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
				</div>

				<div class="strip">
					<div class="item">
						<div class="num">4+</div>
						<div class="label">Tahun membangun aplikasi web</div>
					</div>
					<div class="item">
						<div class="num">9</div>
						<div class="label">Aplikasi yang dikerjakan (Invoice Pro, KMS BPK, Tap-MM, SISAPRA, KPR, Konsumer, SISUKA, SIPADD, SMART)</div>
					</div>
					<div class="item">
						<div class="num">Perbankan · Pemerintahan · Enterprise</div>
						<div class="label">Pengalaman lintas industri</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Experience -->
		<section class="experience" id="experience">
			<div class="wrap">
				<div class="s-kicker">Pengalaman</div>
				<h2 class="s-title">Pengalaman kerja</h2>

				<div class="employer-line">
					<span class="name">PT Tristar Surya Gemilang</span>
					<span class="date">Agu 2022 – sekarang</span>
				</div>
				<p class="employer-sub">
					Software engineer di software house; ditempatkan di tim klien
					pada proyek perbankan, pemerintahan, dan enterprise.
				</p>

				{experiences.map((exp, i) => (
					<div class="proj-line">
						<div class="proj-summary">
							<span class="proj-idx">{String(i + 1).padStart(2, '0')}</span>
							<div class="proj-info">
								<div class="proj-name">{exp.project}</div>
								<div class="proj-role">{exp.role}</div>
							</div>
							<div class="proj-date">{exp.date}</div>
						</div>
						<div class="proj-details">
							{'lead' in exp && exp.lead && <p class="proj-desc">{exp.lead}</p>}
							<ul class="proj-bullets">
								{exp.bullets.map((item) => (
									<li>{item}</li>
								))}
							</ul>
							{exp.tags.length > 0 && (
								<div class="proj-tags">
									{exp.tags.map((tag) => (
										<span class="stack-tag">{tag}</span>
									))}
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Cara kerja -->
		<section class="how" id="how">
			<div class="wrap">
				<h2 class="s-title">Cara kerja</h2>

				<div class="how-list">
					<div class="how-item">
						<div class="how-item-title">Telusuri sampai akar masalah</div>
						<p class="how-item-body">Karena mengerjakan frontend dan backend, saya tidak berhenti di tampilan. Contohnya bug tanggal yang bergeser sekitar 7 jam di Invoice Pro: saya telusuri sampai penyebabnya, yaitu perubahan zona waktu worker ke UTC+7.</p>
					</div>
					<div class="how-item">
						<div class="how-item-title">Diskusi dulu, baru bangun</div>
						<p class="how-item-body">Sebelum mengerjakan fitur, saya cek ke tim backend atau QA soal data yang tersedia dan kebutuhan sebenarnya, supaya tidak ada pengerjaan ulang. Di proyek KPR Bank BJB, saya bekerja bersama tim QA dan Security agar hasilnya sesuai standar keamanan bank.</p>
					</div>
					<div class="how-item">
						<div class="how-item-title">Terbuka soal prioritas dan risiko</div>
						<p class="how-item-body">Saya pernah memegang dua proyek paralel (BJBS dan KMS). Kalau ada risiko jadwal, saya sampaikan lebih awal dan sebutkan apa yang bisa didahulukan.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Project -->
		<section class="featured" id="work">
			<div class="featured-head">
				<div class="s-kicker">Proyek pilihan</div>
				<h2 class="s-title" style="margin-bottom: 0;">Yang saya bangun untuk diri sendiri</h2>
			</div>

			<!-- TODO: ganti dengan screenshot baru berisi data dummy -->
			<a
				class="gallery-frame"
				href="https://life-os.rejip.my.id/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Buka aplikasi Life OS"
			>
				<img
					src="/life-os.webp"
					alt="Life OS personal finance dashboard showing the available spending balance card, natural-language transaction input, and account overview"
					loading="lazy"
					width="3306"
					height="1456"
				/>
			</a>

			<div class="fp-body">
				<div class="fp-top">
					<div>
						<h3 class="fp-title">Life OS</h3>
						<div class="fp-sub">Aplikasi manajemen keuangan pribadi · Proyek pribadi sejak 7 Sep 2026, dipakai sendiri</div>
					</div>
					<div class="fp-actions">
						<!-- TODO: arahkan ke deep link alur guest jika tersedia; saat ini mengarah ke URL aplikasi -->
						<a class="btn-primary" href="https://life-os.rejip.my.id/" target="_blank" rel="noopener noreferrer">Coba sebagai Guest</a>
						<!-- TODO: ganti menjadi <a class="btn-secondary" href="URL_REPO">Source code</a> saat URL repo GitHub tersedia -->
						<span class="btn-secondary" aria-disabled="true">Source code</span>
					</div>
				</div>

				<p class="fp-desc">AI mengusulkan, kode memutuskan.</p>

				<p class="fp-body-text">
					Mencatat pengeluaran lewat form itu melelahkan. Di Life OS cukup ketik
					"jajan 18rb cash". AI (model via Groq API) hanya menafsirkan kalimat itu
					menjadi usulan transaksi. Backend ASP.NET Core memvalidasi, dan tidak ada
					yang tersimpan sebelum kamu konfirmasi. Kalau akun tidak disebut, sistem
					memakai akun default atau meminta kamu memilih. Pilihan bank di atas input
					ada untuk mempercepat, karena mengetik nama sumber dana terasa lama.
				</p>

				<div class="fp-stack">
					<span class="stack-tag">React</span>
					<span class="stack-tag">TypeScript</span>
					<span class="stack-tag">ASP.NET Core</span>
					<span class="stack-tag">PostgreSQL</span>
					<span class="stack-tag">Groq API</span>
				</div>

				<div class="fp-case">
					<div>
						<div class="label">Yang saya bangun</div>
						<div class="body">Merancang model domain keuangan dan alur data. Frontend dengan React dan TypeScript, backend API dengan ASP.NET Core.</div>
					</div>
					<div>
						<div class="label">Sistem &amp; deployment</div>
						<div class="body">PostgreSQL untuk penyimpanan data. Perhitungan keuangan untuk saldo tersedia/bebas. Di-deploy di domain sendiri.</div>
					</div>
				</div>

				<div class="fp-demo">
					<div class="nl-flow">
						<span class="stack-tag">jajan 18rb cash</span>
						<span class="nl-arrow" aria-hidden="true">→</span>
						<span class="stack-tag">Pengeluaran · Rp18.000 · Cash</span>
						<span class="nl-arrow" aria-hidden="true">→</span>
						<span class="stack-tag">Pratinjau: [ Konfirmasi ] [ Ubah ]</span>
					</div>

					<div class="fp-notes">
						<div>
							<div class="label">Yang saya pelajari</div>
							<div class="body">Requirement yang saya tulis sendiri pun ternyata kurang setelah aplikasinya dipakai nyata. Dari sini saya lebih paham kenapa kebutuhan klien sering baru jelas setelah produknya digunakan. ASP.NET Core saya pelajari sambil membangun: konsepnya sama, yang berbeda sintaks dan aturan tiap bahasa.</div>
						</div>
						<div>
							<div class="label">Berikutnya</div>
							<div class="body">automated testing dan CI/CD.</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Skills -->
		<section class="skills" id="skills">
			<div class="wrap">
				<div class="s-kicker">Keahlian</div>
				<h2 class="s-title">Teknologi</h2>

				{skillCategories.map((cat) => (
					<div class="skill-row">
						<div class="g-label">{cat.label}</div>
						<div class="g-items">{cat.items}</div>
					</div>
				))}
			</div>
		</section>

		<!-- Education & Languages -->
		<section class="education" id="education">
			<div class="wrap">
				<div class="s-kicker">Pendidikan</div>
				<h2 class="s-title">Latar belakang</h2>

				<div class="edu-card">
					<div class="edu-header">
						<div class="edu-name">Universitas Jenderal Achmad Yani Cimahi</div>
						<div class="edu-date">Agu 2017 – Feb 2022</div>
					</div>
					<div class="edu-degree">S1 Teknik Informatika · IPK 3,51</div>
				</div>

				<div class="edu-langs">
					<div class="lang-row">
						<div class="lang-label">Bahasa Indonesia</div>
						<div class="lang-level">Penutur asli</div>
					</div>
					<div class="lang-row">
						<div class="lang-label">Bahasa Inggris</div>
						<div class="lang-level">Menengah</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact -->
		<section class="contact" id="contact">
			<div class="wrap">
				<div class="contact-panel">
					<div>
						<div class="contact-text">
							Mari membangun sesuatu yang berguna.
						</div>
						<p class="contact-desc">
							Terbuka untuk peran Frontend atau Fullstack (FE-heavy) di software
							house. Prioritas Bandung; WFO, hybrid, atau WFH; bersedia ditempatkan
							di luar Bandung. Notice period 1 bulan, dapat dinegosiasikan.
						</p>
						<div class="contact-links">
							<a href={`mailto:${email}`}>{email}</a>
							<a href={github} target="_blank" rel="noopener noreferrer">github.com/rejipyansah</a>
							<a href={linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/reji-pikriyansah</a>
						</div>
					</div>
					<div class="contact-actions">
						<a class="btn-primary" href={`mailto:${email}`}>Kirim email</a>
						<a class="btn-secondary" href="/Reji_Pikriyansah_CV.pdf" download>Unduh CV</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
